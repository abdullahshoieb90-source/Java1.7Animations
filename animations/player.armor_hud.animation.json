// Original Armor HUD placement animation for Java1.7Animations.
//
// The icon quads are authored at y=500 in model space, but the player entity
// itself is scaled to 0.9375. Without a compensating root-bone scale the quads
// land at 468.75 and fall outside the live_player_renderer viewport, which is
// exactly why v2.6.0/v2.6.1 hid the vanilla armor bar but drew no icons.
// This animation cancels the entity scale on the HUD root bone only, and keeps
// the icons level while swimming/crawling/riding/gliding.
{
  "format_version": "1.8.0",
  "animations": {
    "animation.player.j17_armor_hud": {
      "loop": true,
      "bones": {
        "j17_armor_hud": {
          "position": [
            0,
            "((q.is_swimming || q.is_crawling) ? -20.0 : 0.0) / 0.9375",
            0
          ],
          "rotation": [
            "q.is_gliding ? -q.body_x_rotation - 90.0 : 0.0",
            "(q.is_gliding ? -q.body_y_rotation : 0.0) + (q.is_riding ? q.target_y_rotation : 0.0)",
            0
          ],
          "scale": "1.0 / 0.9375"
        }
      }
    }
  }
}
