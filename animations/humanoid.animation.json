{
  "format_version": "1.10.0",
  "animations": {
    // SpearAnimations.thirdPersonHandUse: Java's clamped SPEAR arm pose.
    "animation.humanoid.melee_spear_hold": {
      "loop": true,
      "override_previous_animation": false,
      "bones": {
        "rightarm": {
          "rotation": [
            "math.clamp(v.tp_melee_spear_base_arm_rotation_x + q.target_x_rotation, -120.0, 30.0) - this",
            "math.clamp(q.target_y_rotation - 5.729578, -60.0, 60.0) - this",
            0.0
          ]
        },
        "rightarm_custom": {
          "rotation": [
            "math.clamp(v.tp_melee_spear_base_arm_rotation_x + q.target_x_rotation, -120.0, 30.0) - this",
            "math.clamp(q.target_y_rotation - 5.729578, -60.0, 60.0) - this",
            0.0
          ]
        }
      }
    },
    // SpearAnimations.thirdPersonUseItem. During attack overlap the controller
    // applies melee_spear_attack first, matching Java's ItemInHandLayer order.
    "animation.humanoid.melee_spear_use": {
      "loop": true,
      "override_previous_animation": false,
      "bones": {
        "rightarm": {
          "rotation": [
            "v.tp_melee_spear_use_arm_rotation_x",
            "v.tp_melee_spear_use_arm_rotation_y",
            "v.tp_melee_spear_use_arm_rotation_z"
          ]
        },
        "rightarm_custom": {
          "rotation": [
            "v.tp_melee_spear_use_arm_rotation_x",
            "v.tp_melee_spear_use_arm_rotation_y",
            "v.tp_melee_spear_use_arm_rotation_z"
          ]
        },
        "rightitem": {
          "position": [
            "math.sin(v.tp_melee_spear_use_item_rotation_z)",
            "v.tp_melee_spear_use_item_position_y - 1.0 + math.cos(v.tp_melee_spear_use_item_rotation_x) * math.cos(v.tp_melee_spear_use_item_rotation_z) + math.sin(v.tp_melee_spear_use_item_rotation_x) * 2.5",
            "6.4 * v.melee_spear_use_hit_feedback_amount - 2.5 - math.sin(v.tp_melee_spear_use_item_rotation_x) * math.cos(v.tp_melee_spear_use_item_rotation_z) + math.cos(v.tp_melee_spear_use_item_rotation_x) * 2.5"
          ],
          "rotation": [
            { "x": "v.tp_melee_spear_use_item_rotation_x" },
            { "z": "v.tp_melee_spear_use_item_rotation_z" }
          ]
        }
      }
    },
    "animation.humanoid.use_item_progress" : {
      "loop" : true,
      "bones" : {
        "rightarm" : {
          "rotation" : [
            // xref: Player::getItemUseStartupProgress
            // identical to v.use_item_startup_progress
            //"t.use_dur = (q.main_hand_item_use_duration > 0.0) ? (q.main_hand_item_use_duration - q.frame_alpha + 1) : 0; t.remaining_use_ticks = q.main_hand_item_max_duration - t.use_dur; t.move_to_mouth_ticks = q.main_hand_item_max_duration - 24; t.delta = t.move_to_mouth_ticks - t.remaining_use_ticks; return (!q.is_item_equipped(0)) ? 0 : ((t.delta < 0) ? 1 : 1 - (t.delta / t.move_to_mouth_ticks));"

            // xref: Player::getItemUseIntervalProgress
            // identical to v.use_item_interval_progress
            //"t.use_dur = (q.main_hand_item_use_duration > 0.0) ? (q.main_hand_item_use_duration - q.frame_alpha + 1) : 0; t.remaining_use_ticks = q.main_hand_item_max_duration - t.use_dur; t.move_to_mouth_ticks = q.main_hand_item_max_duration - 24; t.delta = t.move_to_mouth_ticks - t.remaining_use_ticks; return (!q.is_item_equipped(0) || (t.delta >= 0)) ? 0 : math.mod(-t.delta, 4) * 0.25;"

            "t.norm = math.clamp((q.main_hand_item_max_duration - (q.main_hand_item_use_duration - q.frame_alpha + 1)) * 0.15, 0, 1); t.progress = math.pow(t.norm, 0.5); t.ticks_alive = q.life_time * 20; return (t.progress * -80.2140913183) + ((t.progress >= 1.0) ? (math.cos(t.ticks_alive * 97.4028251722) * 4.58366236105) * (1 - v.attack_time) : 0) + (t.progress * 18.0);",
            "t.norm = math.clamp((q.main_hand_item_max_duration - (q.main_hand_item_use_duration - q.frame_alpha + 1)) * 0.15, 0, 1); t.progress = t.norm; return t.progress * -25.7831007809;",
            0
          ]
        },
        "rightarm_custom" : {
          "rotation" : [
            "t.norm = math.clamp((q.main_hand_item_max_duration - (q.main_hand_item_use_duration - q.frame_alpha + 1)) * 0.15, 0, 1); t.progress = math.pow(t.norm, 0.5); t.ticks_alive = q.life_time * 20; return (t.progress * -80.2140913183) + ((t.progress >= 1.0) ? (math.cos(t.ticks_alive * 97.4028251722) * 4.58366236105) * (1 - v.attack_time) : 0) + (t.progress * 18.0);",
            "t.norm = math.clamp((q.main_hand_item_max_duration - (q.main_hand_item_use_duration - q.frame_alpha + 1)) * 0.15, 0, 1); t.progress = t.norm; return t.progress * -25.7831007809;",
            0
          ]
        }
      }
    }
  }
}