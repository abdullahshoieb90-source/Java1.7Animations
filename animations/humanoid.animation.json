    // Spear support (Minecraft 1.21.110+/1.26). This file shadows vanilla's humanoid.animation.json,
    // so the spear poses vanilla added have to be re-declared here.
    "animation.humanoid.melee_spear_hold": {
      "loop": true,
      "bones": {
        "rightarm": {
          "rotation": [
            "v.tp_melee_spear_base_arm_rotation_x + q.target_x_rotation - q.is_sneaking * 27.0 - this",
            "math.clamp(q.target_y_rotation, -60.0, 45.0) - this",
            0.0
          ]
        },
        "rightitem": {
          "position": [ 0.0, -1.5, -1.5 ]
        }
      }
    },
    "animation.humanoid.melee_spear_use": {
      "loop": true,
      "bones": {
        "rightarm": {
          "rotation": [
            "v.tp_melee_spear_base_arm_rotation_x + q.target_x_rotation - q.is_sneaking * 27.0 - this + v.tp_melee_spear_use_arm_rotation_x",
            "math.clamp(q.target_y_rotation, -60.0, 45.0) - this + v.tp_melee_spear_use_arm_rotation_y",
            "v.tp_melee_spear_use_arm_rotation_z"
          ]
        },
        "rightitem": {
          "position": [ 0.0, -1.5, -1.5 ],
          "rotation": [ "v.tp_melee_spear_use_item_rotation_x", 0.0, 0.0 ]
        }
      }
    }
