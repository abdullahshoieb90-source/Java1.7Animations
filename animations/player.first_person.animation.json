// Spear equations and item transforms ported from Minecraft Java 1.21.11 SpearAnimations/ItemInHandRenderer.
{
  "format_version" : "1.10.0",
  "animations": {
    "animation.player.first_person.attack_rotation" : {
      "loop" : true,
      "bones" : {
        "rightarm" : {
          "position" : [
            "math.sin(math.pow(v.attack_time, 0.5) * 180.0) * -2.6",
            "math.sin(math.pow(v.attack_time, 0.5) * 360.0) * 6.1",
            "math.sin(math.pow(v.attack_time, 1.1) * 180.0) * 3.1"
          ],
          "rotation" : [
            "math.sin(math.pow(v.attack_time, 0.45) * 180.0) * -52.5",
            "math.sin(math.pow(v.attack_time, 0.5) * 180.0) * 48.0",
            "math.sin(math.pow(v.attack_time, 0.3) * 180.0) * 23.5"
          ]
        }
      }
    },
    "animation.player.first_person.empty_hand" : {
      "loop" : true,
      "bones" : {
        "rightarm" : {
          "position" : [ 13.15, "(v.short_arm_offset_right * 1.8) - 7.45", 10.5 ],
          "rotation" : [ 95.5, -40.0, 116.0 ]
        }
      }
    },
    // Java's generic first-person item path: applyItemArmTransform + spear display transform.
    "animation.player.first_person.melee_spear_base": {
      "loop": true,
      "override_previous_animation": true,
      "bones": {
        "rightarm": {
          "position": [ "-this", "-22.0 + v.short_arm_offset_right", "-this" ],
          "rotation": [ "-this", "-this", "-this" ]
        },
        "rightitem": {
          "position": [ "8.96 - this", "19.2 - this", "11.52 - this" ],
          "rotation": [ "-this", "180.0 - this", "-this" ]
        }
      }
    },
    "animation.player.first_person.melee_spear_hold": {
      "loop": true,
      "override_previous_animation": false,
      "bones": {
        "rightitem": {
          "position": [ 0.0, 0.0, 0.0 ],
          "rotation": [ 0.0, 0.0, 0.0 ]
        }
      }
    },
    // SpearAnimations.firstPersonUse, including both rotateAround pivots and hit feedback.
    "animation.player.first_person.melee_spear_use": {
      "loop": true,
      "override_previous_animation": false,
      "bones": {
        "rightitem": {
          "position": [
            "v.fp_melee_spear_use_item_position_x + 2.4 + math.cos(v.fp_melee_spear_use_item_rotation_y) * -2.4",
            "v.fp_melee_spear_use_item_position_y + 1.6 + math.cos(-v.fp_melee_spear_use_item_rotation_x) * (-1.6 - 16.0 * v.melee_spear_use_hit_feedback_amount) + math.sin(-v.fp_melee_spear_use_item_rotation_x) * -math.sin(v.fp_melee_spear_use_item_rotation_y) * -2.4",
            "v.fp_melee_spear_use_item_position_z - math.sin(-v.fp_melee_spear_use_item_rotation_x) * (-1.6 - 16.0 * v.melee_spear_use_hit_feedback_amount) + math.cos(-v.fp_melee_spear_use_item_rotation_x) * -math.sin(v.fp_melee_spear_use_item_rotation_y) * -2.4"
          ],
          "rotation": [
            { "x": "v.fp_melee_spear_use_item_rotation_x" },
            { "y": "v.fp_melee_spear_use_item_rotation_y" }
          ]
        }
      }
    },
    // SpearAnimations.firstPersonAttack: outBack thrust, X rotation, then local Z recovery.
    "animation.player.first_person.melee_spear_attack": {
      "loop": true,
      "override_previous_animation": false,
      "bones": {
        "rightitem": {
          "position": [
            "1.6 * (v.melee_spear_attack_raise_scale - v.fp_melee_spear_attack_thrust_scale)",
            "-1.2 * (v.melee_spear_attack_raise_scale - v.melee_spear_attack_recover_scale) - 4.0 * (v.melee_spear_attack_recover_scale - v.fp_melee_spear_attack_thrust_scale) * math.sin(v.fp_melee_spear_attack_item_rotation_x)",
            "-10.4 * (v.melee_spear_attack_raise_scale - v.fp_melee_spear_attack_thrust_scale) + 4.0 * (v.melee_spear_attack_recover_scale - v.fp_melee_spear_attack_thrust_scale) * math.cos(v.fp_melee_spear_attack_item_rotation_x)"
          ],
          "rotation": [ "v.fp_melee_spear_attack_item_rotation_x", 0.0, 0.0 ]
        }
      }
    },
    "animation.player.first_person.swap_item": {
      "loop": true,
      "bones": {
        "leftarm": {
          "position": [
            0.0,
            "q.is_item_name_any('slot.weapon.offhand', 'minecraft:filled_map', 'minecraft:shield') ? 0.0 : (1.0 - c.player_offhand_arm_height) * -10.0",
            0.0
          ]
        },
        "rightarm": {
          "position": [
            0.0,
            "(1.0 - v.player_arm_height) * -10.0",
            0.0
          ]
        }
      }
    },
    "animation.player.first_person.map_hold": {
      "loop": true,
      "bones": {
        "leftarm": {
          "position": [
            -15.5,
            "-7.5 - v.short_arm_offset_left - (v.map_angle * 8.0)",
            "9.0 + v.short_arm_offset_left - (v.map_angle * 8.0)"
          ],
          "rotation": [
            37.5,
            -20,
            -150
          ]
        },
        "rightarm": {
          "position": [
            15.5,
            "-7.0 - v.short_arm_offset_right - (v.map_angle * 8.0)",
            "8.0 + v.short_arm_offset_right - (v.map_angle * 8.0)"
          ],
          "rotation": [
            50,
            30,
            165
          ]
        }
      }
    },
    "animation.player.first_person.map_hold_attack": {
      "loop": true,
      "bones": {
        "leftarm": {
          "position": [
            "math.sin(math.pow(v.attack_time, 0.5) * 180.0) * -3.0",
            "math.sin(math.pow(v.attack_time, 0.5) * 360.0) * 3.0",
            "math.sin(math.pow(v.attack_time, 1.0) * 180.0) * 4.0"
          ],
          "rotation": [ "v.map_angle * 90.0", 0, 0 ]
        },
        "rightarm": {
          "position": [
            "math.sin(math.pow(v.attack_time, 0.5) * 180.0) * -8.0",
            "math.sin(math.pow(v.attack_time, 0.5) * 360.0) * 4.5",
            "math.sin(math.pow(v.attack_time, 1.0) * 180.0) * 4.0"
          ],
          "rotation": [ "v.map_angle * 90.0", 0, 0 ]
        }
      }
    },
    "animation.player.first_person.map_hold_main_hand": {
      "loop": true,
      "bones": {
        "rightarm": {
          "position" : [
            "14.5 - (math.sin(v.attack_time * 180.0) * 2.0)",
            "(v.short_arm_offset_right * 1.5) - 7.0 + (math.sin(math.pow(v.attack_time, 0.5) * 360.0) * 4.0)",
            "9.0 + (math.sin(math.pow(v.attack_time, 0.5) * 180.0) * 3.0)"
          ],
          "rotation" : [ 90.0, -40.0, 105.0 ]
        }
      }
    },
    "animation.player.first_person.map_hold_off_hand": {
      "loop": true,
      "bones": {
        "leftarm": {
          "position" : [
            -14.4,
            "(v.short_arm_offset_left * 1.5) - 7.0",
            9.0
          ],
          "rotation" : [ -92.5, 135, 77.5 ]
        }
      }
    }
  }
}