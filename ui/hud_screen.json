{
  "namespace": "hud",
  // === Armor HUD (ported from XeroxClient by @Greninja) ===
  // Xerox draws the four high-offset armor quads through this live player renderer
  // in root_panel; the paper-doll renderer alone is not the Armor HUD hook.
  // Visibility follows #hud_visible so it hides together with the HUD.
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "armor_hud_renderer": {
              "allow_clipping": false,
              "type": "custom",
              "renderer": "live_player_renderer",
              "size": [ 16, 16 ],
              "offset": [ 18, 442 ],
              "anchor_from": "bottom_middle",
              "anchor_to": "bottom_middle",
              "bindings": [
                {
                  "binding_type": "global",
                  "binding_name": "#hud_visible",
                  "binding_name_override": "#visible",
                  "binding_condition": "always"
                }
              ]
            }
          }
        ]
      }
    ]
  },

  "vignette_renderer": {
    "ignored": true
  },

  "hud_tip_text": {
    "alpha": 0
  },
  "hud_tip_text/item_text_label": {
    "shadow": true
  },

  "hud_actionbar_text": {
    "alpha": 0
  },
  "hud_actionbar_text/actionbar_message": {
    "shadow": true
  },

  "hud_title_text/title_frame/title_background": {
    "ignored": true
  },
  "hud_title_text/subtitle_frame/subtitle_background": {
    "ignored": true
  },
  "hud_title_text/title_frame/title": {
    "shadow": true
  },
  "hud_title_text/subtitle_frame/subtitle": {
    "shadow": true
  },

  "item_name_text_root/item_text_aligner/item_text_control/item_text_background": {
    "ignored": true
  },
  "item_name_text_root/item_text_aligner/item_text_control/item_text_label": {
    "shadow": true
  }
}