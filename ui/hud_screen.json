  // Java1.7Animations Armor HUD: replace the vanilla armor-points bar with
  // the four equipped-armor item icons (Xerox-style). The icons themselves
  // live in ui/armor_hud.json and are drawn by the player entity through a
  // live_player_renderer, so no behavior pack is required.
  "armor_renderer": {
    "ignored": true
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "j17_armor_hud@j17_armor_hud.armor_hud": {} }
        ]
      }
    ]
  }
