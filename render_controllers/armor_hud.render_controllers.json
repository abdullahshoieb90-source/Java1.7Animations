// Original Armor HUD render controllers for Java1.7Animations.
// Draws the four equipped-armor item icons (or empty-slot icons) as camera
// facing quads. Gated by v.j17_render_in_hud, which the player entity sets
// only while the local player is being drawn inside the HUD.
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.j17_armor_hud_helmet": {
      "arrays": {
        "textures": {
          "array.j17_helmets": [
            "texture.j17_hud_empty_helmet",
            "texture.j17_hud_leather_helmet",
            "texture.j17_hud_chainmail_helmet",
            "texture.j17_hud_iron_helmet",
            "texture.j17_hud_diamond_helmet",
            "texture.j17_hud_gold_helmet",
            "texture.j17_hud_gold_helmet",
            "texture.j17_hud_turtle_helmet",
            "texture.j17_hud_netherite_helmet",
            "texture.j17_hud_copper_helmet",
            "texture.j17_hud_pumpkin"
          ]
        }
      },
      "geometry": "geometry.j17_hud_helmet",
      "materials": [ { "*": "material.j17_armor_hud" } ],
      "textures": [
        "array.j17_helmets[q.is_item_name_any('slot.armor.head', 0, 'minecraft:carved_pumpkin') ? 10 : (q.armor_texture_slot(0) + 1)]"
      ],
      "color": {
        "r": "q.armor_color_slot(0, 0)",
        "g": "q.armor_color_slot(0, 1)",
        "b": "q.armor_color_slot(0, 2)",
        "a": "q.armor_color_slot(0, 3)"
      },
      "ignore_lighting": true,
      "filter_lighting": true,
      "part_visibility": [ { "*": true } ]
    },
    "controller.render.j17_armor_hud_chestplate": {
      "arrays": {
        "textures": {
          "array.j17_chestplates": [
            "texture.j17_hud_empty_chestplate",
            "texture.j17_hud_leather_chestplate",
            "texture.j17_hud_chainmail_chestplate",
            "texture.j17_hud_iron_chestplate",
            "texture.j17_hud_diamond_chestplate",
            "texture.j17_hud_gold_chestplate",
            "texture.j17_hud_elytra",
            "texture.j17_hud_elytra",
            "texture.j17_hud_netherite_chestplate",
            "texture.j17_hud_copper_chestplate"
          ]
        }
      },
      "geometry": "geometry.j17_hud_chestplate",
      "materials": [ { "*": "material.j17_armor_hud" } ],
      "textures": [ "array.j17_chestplates[q.armor_texture_slot(1) + 1]" ],
      "color": {
        "r": "q.armor_color_slot(1, 0)",
        "g": "q.armor_color_slot(1, 1)",
        "b": "q.armor_color_slot(1, 2)",
        "a": "q.armor_color_slot(1, 3)"
      },
      "ignore_lighting": true,
      "filter_lighting": true,
      "part_visibility": [ { "*": true } ]
    },
    "controller.render.j17_armor_hud_leggings": {
      "arrays": {
        "textures": {
          "array.j17_leggings": [
            "texture.j17_hud_empty_leggings",
            "texture.j17_hud_leather_leggings",
            "texture.j17_hud_chainmail_leggings",
            "texture.j17_hud_iron_leggings",
            "texture.j17_hud_diamond_leggings",
            "texture.j17_hud_gold_leggings",
            "texture.j17_hud_gold_leggings",
            "texture.j17_hud_gold_leggings",
            "texture.j17_hud_netherite_leggings",
            "texture.j17_hud_copper_leggings"
          ]
        }
      },
      "geometry": "geometry.j17_hud_leggings",
      "materials": [ { "*": "material.j17_armor_hud" } ],
      "textures": [ "array.j17_leggings[q.armor_texture_slot(2) + 1]" ],
      "color": {
        "r": "q.armor_color_slot(2, 0)",
        "g": "q.armor_color_slot(2, 1)",
        "b": "q.armor_color_slot(2, 2)",
        "a": "q.armor_color_slot(2, 3)"
      },
      "ignore_lighting": true,
      "filter_lighting": true,
      "part_visibility": [ { "*": true } ]
    },
    "controller.render.j17_armor_hud_boots": {
      "arrays": {
        "textures": {
          "array.j17_boots": [
            "texture.j17_hud_empty_boots",
            "texture.j17_hud_leather_boots",
            "texture.j17_hud_chainmail_boots",
            "texture.j17_hud_iron_boots",
            "texture.j17_hud_diamond_boots",
            "texture.j17_hud_gold_boots",
            "texture.j17_hud_gold_boots",
            "texture.j17_hud_gold_boots",
            "texture.j17_hud_netherite_boots",
            "texture.j17_hud_copper_boots"
          ]
        }
      },
      "geometry": "geometry.j17_hud_boots",
      "materials": [ { "*": "material.j17_armor_hud" } ],
      "textures": [ "array.j17_boots[q.armor_texture_slot(3) + 1]" ],
      "color": {
        "r": "q.armor_color_slot(3, 0)",
        "g": "q.armor_color_slot(3, 1)",
        "b": "q.armor_color_slot(3, 2)",
        "a": "q.armor_color_slot(3, 3)"
      },
      "ignore_lighting": true,
      "filter_lighting": true,
      "part_visibility": [ { "*": true } ]
    }
  }
}
